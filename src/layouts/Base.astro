---
// Gabarit commun : en-tête HTML, polices, et les deux petits scripts de la page.
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import type { Copy } from '../i18n';
import { SITE } from '../config';
import release from '../data/release.json';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const path = copy.lang === 'fr' ? '/' : '/en/';
const canonical = new URL(path, SITE.url).href;
// Image de partage : une par langue, fabriquée par `pnpm og` (scripts/og-image.mjs).
const shareImage = new URL(`/og-${copy.lang}.png`, SITE.url).href;
const shareAlt = `PlannerCraft — ${copy.hero.slogan}`;

// Données structurées pour les moteurs de recherche. Mêmes garde-fous que le texte de la page :
// rien qui ne soit vérifiable dans le dépôt de l'application (docs/DECISIONS.md, D-010).
const home = new URL('/', SITE.url).href;
const structured = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${home}#site`, name: 'PlannerCraft', url: home, inLanguage: ['fr', 'en'] },
    {
      '@type': 'SoftwareApplication',
      '@id': `${canonical}#app`,
      name: 'PlannerCraft',
      url: canonical,
      description: copy.meta.description,
      inLanguage: copy.lang,
      image: shareImage,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'macOS, Windows, Linux',
      ...(release.version ? { softwareVersion: release.version } : {}),
      downloadUrl: `${canonical}#download`,
      sameAs: SITE.repo,
      // Le logiciel est gratuit ; les crédits de l'assistant sont un achat à part, facultatif.
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    },
  ],
};
// `<` échappé : le texte ne peut pas refermer la balise <script>.
const structuredJson = JSON.stringify(structured).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL('/', SITE.url).href} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="apple-touch-icon" href="/icon-256.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PlannerCraft" />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={copy.lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={copy.lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={structuredJson} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Avant le premier affichage : active la scène animée, sauf si l'utilisateur a demandé moins de mouvement.
      // Filet de sécurité : si le script de la scène n'a pas démarré après 4 s, on revient à la page statique.
      (function () {
        var root = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('js-live');
        setTimeout(function () {
          if (!window.__pcStage) root.classList.remove('js-live');
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Apparition des blocs au scroll, et mise en avant du téléchargement qui correspond au système du visiteur.
      const root = document.documentElement;
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (items.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px' },
        );
        root.classList.add('reveal-on');
        items.forEach((item) => observer.observe(item));
      }

      // Système du visiteur. Un téléphone ou une tablette n'en a aucun des trois : leur
      // identité contient pourtant « Mac » (iPhone, iPad) ou « Linux » (Android).
      const platform = navigator.userAgent;
      const handheld = /Android|iPhone|iPad|iPod|Mobile/i.test(platform) || (/Mac/i.test(platform) && navigator.maxTouchPoints > 1);
      const os = handheld ? '' : /Windows/i.test(platform) ? 'win' : /Mac/i.test(platform) ? 'mac' : /Linux|X11/i.test(platform) ? 'linux' : '';
      if (os) {
        const mine = document.querySelectorAll<HTMLAnchorElement>(`a[data-os="${os}"]`);
        mine.forEach((button) => button.classList.add('is-mine'));
        // Le bouton principal télécharge directement le fichier du système reconnu ;
        // sinon il garde son ancre vers les trois téléchargements.
        const direct = mine[0]?.href;
        if (direct && !/\/releases(\/tag\/[^/]+)?\/?$/.test(direct)) {
          document.querySelectorAll<HTMLAnchorElement>('a[data-download]').forEach((button) => (button.href = direct));
        }
      }
    </script>
  </body>
</html>
