---
// Le rapprochement avec MS Project, et la capture de l'application.
import { Image } from 'astro:assets';
import type { Copy } from '../i18n';
import shot from '../assets/gantt-fr.png';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
---

<section class="section" id="why">
  <div class="wrap familiar">
    <div class="familiar__text" data-reveal>
      <h2 class="h-section">{copy.familiar.title}</h2>
      <p class="lede">{copy.familiar.sub}</p>
    </div>
    <div class="familiar__panel" data-reveal>
      <Image src={shot} alt={copy.familiar.alt} widths={[640, 960, 1280]} sizes="(min-width: 1264px) 1088px, 90vw" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .familiar {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 48px);
  }
  .familiar__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .familiar__panel {
    padding: clamp(12px, 4.5vw, 56px);
    border-radius: clamp(24px, 3.4vw, 40px);
    background: var(--yellow);
  }
  .familiar__panel img {
    width: 100%;
    border-radius: clamp(8px, 1.2vw, 14px);
    box-shadow: 0 24px 60px rgba(11, 11, 15, 0.28);
  }
</style>
