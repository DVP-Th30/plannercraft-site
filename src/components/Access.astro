---
// Les deux façons d'activer l'assistant IA : un compte avec des crédits, ou sa propre clé.
import type { Copy } from '../i18n';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const a = copy.access;
---

<section class="section" id="ai">
  <div class="wrap access">
    <div class="access__text" data-reveal>
      <h2 class="h-section">{a.title}</h2>
      <p class="lede">{a.sub}</p>
    </div>
    <div class="access__cards">
      <article class="card" data-reveal>
        <span class="card__bar" style="width: 148px; background: var(--green)" aria-hidden="true"></span>
        <h3>{a.account.title}</h3>
        <p>{a.account.sub}</p>
      </article>
      <article class="card" data-reveal style="--reveal-delay: 0.08s">
        <span class="card__bar" style="width: 96px; background: var(--magenta)" aria-hidden="true"></span>
        <h3>{a.key.title}</h3>
        <p>{a.key.sub}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .access {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 48px);
  }
  .access__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .access__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(14px, 2vw, 24px);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: clamp(26px, 3vw, 40px);
    border-radius: clamp(24px, 2.8vw, 32px);
    background: var(--mist);
  }
  .card__bar {
    height: 22px;
    border-radius: 11px;
    margin-bottom: 10px;
  }
  .card h3 {
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .card p {
    max-width: 40ch;
    color: var(--muted);
  }
</style>
