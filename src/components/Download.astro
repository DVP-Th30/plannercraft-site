---
// Panneau final : les trois téléchargements, la version navigateur, le code source, puis le pied de page.
import type { Copy } from '../i18n';
import { SITE, downloadHref } from '../config';
import Logo from './Logo.astro';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const d = copy.download;
---

<section class="section" id="download">
  <div class="wrap">
    <div class="panel" data-reveal>
      <div class="panel__bars" aria-hidden="true">
        <span style="width: 120px; background: var(--violet)"></span>
        <span style="width: 64px; background: var(--red)"></span>
        <span style="width: 168px; background: var(--yellow)"></span>
        <span style="width: 88px; background: var(--cyan)"></span>
        <span style="width: 140px; background: var(--green)"></span>
      </div>
      <h2>{d.title}</h2>
      <p class="panel__sub">{d.sub}</p>
      <ul class="panel__os">
        {
          d.os.map((os) => (
            <li>
              <a class="btn btn--outline-light os" href={downloadHref(os.id)} data-os={os.id}>
                <span class="os__name">{os.name}</span>
                <span class="os__detail">{os.detail}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="panel__more">
        <a class="btn btn--outline-light" href={SITE.webApp}>{d.browser}</a>
        <a class="source" href={SITE.repo}>
          {d.source}
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<footer class="wrap footer">
  <div class="footer__brand">
    <Logo size="28px" />
    PlannerCraft
  </div>
  <p>{copy.footer.legal}</p>
  <a href={copy.nav.switchHref} hreflang={copy.nav.switchLang} lang={copy.nav.switchLang}>{copy.nav.switchTo}</a>
</footer>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: clamp(32px, 7vw, 96px);
    border-radius: clamp(28px, 4vw, 48px);
    background: var(--ink);
    color: var(--paper);
  }
  .panel__bars {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 16px;
  }
  .panel__bars span {
    height: 24px;
    border-radius: 12px;
  }
  .panel h2 {
    font-size: clamp(40px, 6.2vw, 88px);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .panel__sub {
    font-size: clamp(18px, 1.6vw, 21px);
    color: #d5d7db;
  }
  .panel__os {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 16px 0 0;
    list-style: none;
  }
  .os {
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    min-width: 168px;
    min-height: 68px;
    padding: 10px 26px;
    border-radius: 22px;
  }
  /* Le téléchargement qui correspond au système du visiteur passe en blanc plein. */
  .os:global(.is-mine) {
    background: var(--paper);
    color: var(--ink);
  }
  .os__name {
    font-size: 19px;
    line-height: 1.2;
  }
  .os__detail {
    font-size: 13.5px;
    font-weight: 500;
    opacity: 0.78;
  }
  .panel__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    padding-top: 4px;
  }
  .source {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 500;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-block: clamp(48px, 6vw, 72px) 56px;
    font-size: 14px;
    color: var(--soft);
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
    color: var(--ink);
  }
  .footer p {
    flex: 1 1 320px;
    max-width: 62ch;
  }
  .footer a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 500;
    color: var(--ink);
  }
</style>
